# Required
OPENAI_API_KEY=sk-...
WAHA_API_KEY=generate-a-random-secret-32-chars

# Optional — AI provider settings
# Use any OpenAI-compatible API by setting OPENAI_BASE_URL
# Examples:
#   OpenRouter (free models): https://openrouter.ai/api/v1
#   TokenRouter (free models): https://api.tokenrouter.com/v1
#   Groq (fast, free tier):   https://api.groq.com/openai/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
WAHA_URL=http://waha:3000
KNOWLEDGE_DIR=./knowledge
PORT=3333
MAX_HISTORY=10
MEMORY_TTL_MS=3600000
LOG_LEVEL=info
TEST_MODE=0
OWNER_NUMBERS=